# Cheap First
# Copy to .env. Keys stay on the server. .env is gitignored; this file is not.
# Nothing here turns Stripe on, and nothing here changes the $0.005 price.

# --- Models (required to answer) ---
# Dolphin, from app.dphn.ai → API Keys. The misspelling DOLHPIN_API_KEY is also accepted.
DOLPHIN_API_KEY=
# SERV Reasoning, from console.openserv.ai. Used for the checker and the premium model.
SERV_API_KEY=

# Checker. Leave unset for SERV GPT-6 Luna. "dolphin" has the cheap model check itself.
# CF_CHECKER=dolphin

# How hard the cheap model thinks first. Default "low" (same accuracy on the public
# 300, slowest answer 8.3 s instead of 28.8 s). "default" lets Dolphin decide.
# CF_CHEAP_REASONING=low
# Send a second cheap request if the first hasn't answered after this many ms. 0 turns it off.
# CF_CHEAP_HEDGE_MS=8000

# Reply length cap for each model call. Default 16000.
# CF_MAX_TOKENS=16000
# Premium answer cap, so one escalation stays near $0.05. Default 2000.
# CF_PREMIUM_MAX_TOKENS=2000

# --- Free demo (/api/ask and free MCP calls share these) ---
# CF_PER_IP_PER_HOUR=10
# CF_DAILY_CAP=300
# Daily premium-model budget for the free demo, in US dollars. Default 1.
# CF_DEMO_PREMIUM_BUDGET_USD=1

# --- Paid answers (/api/pay, /api/v1, and paid MCP calls) ---
# Daily premium-model budget shared by every paid endpoint. Default 2.
# CF_PAID_PREMIUM_BUDGET_USD=2
# Price per answer in USDC micro-units. 5000 is $0.005, the public price. Leave unset.
# PRICE_USDC_MICRO=5000
# Wallet that receives USDC. Defaults to the project wallet when unset.
# PAY_TO_ADDRESS=
# Facilitator that verifies and settles x402. Defaults to Coinbase when the CDP keys
# below are set, otherwise PayAI.
# X402_FACILITATOR_URL=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# --- Shared counters (Upstash Redis). Prepaid keys refuse to work without this. ---
# Vercel's Upstash integration sets the KV_ names. Either pair works.
# The public /stats page uses the same store for aggregate counters only
# (requests, escalations, dollars). It does not store questions or keys.
# With neither pair set, /stats stays empty and records nothing.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Trial API keys. Free cf_ keys the owner hands out. Stripe stays off. ---
# Secret for POST /api/admin/keys. Unset and that endpoint refuses. Use a long random value.
# CF_ADMIN_TOKEN=
# Answers when a trial key is created without an "answers" field. Default 200.
# CF_TRIAL_ANSWERS=200
# Requests each key may make in one minute. Default 20.
# CF_KEY_RATE_PER_MIN=20
# Daily cap, in US dollars, on cheap + checker + premium spend for every API key together.
# Default 3. This sits on top of CF_PAID_PREMIUM_BUDGET_USD. x402 calls are not counted.
# CF_DAILY_SPEND_CAP_USD=3

# --- Card payments. Leave both unset and Stripe stays off. ---
# STRIPE_SECRET_KEY=
# A Stripe Payment Link. The site shows "pay by card" only when this is set at build time.
# CF_CARD_LINK=

# --- OpenServ agent (api/openserv.ts) ---
# OPENSERV_API_KEY=
# OPENSERV_AUTH_TOKEN=
# OPENSERV_API_URL=https://api.openserv.ai
# OPENSERV_RUNTIME_URL=https://agents.openserv.ai
# CF_OPENSERV_DAILY_ANSWERS=300
# CF_OPENSERV_PREMIUM_BUDGET_USD=1

# --- Output verifier, free tier ---
# CF_VERIFY_FREE_PER_IP=20
# CF_VERIFY_FREE_PER_DAY=300

# --- NEAR AI Agent Market (api/near.ts) ---
# NEAR_AGENT_TOKEN=
# NEAR_WEBHOOK_SECRET=
# NEAR_API_URL=https://market.near.ai

# --- Site build (GitHub Pages). The Try it box posts here. ---
# ASK_URL=https://cheap-first.vercel.app/api/ask

# --- MCP stdio bridge (npm run mcp). These are for the client, not the server. ---
# CHEAP_FIRST_API_KEY=cf_...
# CHEAP_FIRST_MCP_URL=https://cheap-first.vercel.app/mcp
# Set to 1 to send X-Cheap-First-Paid, which asks the server for an x402 challenge.
# CHEAP_FIRST_PAID=1

# --- Benchmark scripts only ---
# REPPO_API_KEY=
# REPPO_API_URL=https://eval.reppo.xyz/api/v1
