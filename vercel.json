{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/ask.ts": {
      "maxDuration": 300
    },
    "api/pay.ts": {
      "maxDuration": 300
    },
    "api/v1/chat/completions.ts": {
      "maxDuration": 300
    },
    "api/key.ts": {
      "maxDuration": 30
    },
    "api/openserv.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/x402",
      "destination": "/api/discovery"
    },
    {
      "source": "/openserv",
      "destination": "/api/openserv"
    },
    {
      "source": "/openserv/:path*",
      "destination": "/api/openserv?path=:path*"
    }
  ]
}
