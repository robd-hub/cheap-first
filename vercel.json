{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/ask.ts": {
      "maxDuration": 300
    },
    "api/pay.ts": {
      "maxDuration": 300
    },
    "api/v1/chat/completions.ts": {
      "maxDuration": 300
    },
    "api/key.ts": {
      "maxDuration": 30
    },
    "api/openserv.ts": {
      "maxDuration": 300
    },
    "api/verify.ts": {
      "maxDuration": 60
    },
    "api/near.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/verify/quick",
      "destination": "/api/verify?level=quick"
    },
    {
      "source": "/api/verify/free",
      "destination": "/api/verify?level=free"
    },
    {
      "source": "/.well-known/x402",
      "destination": "/api/discovery"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/openapi"
    },
    {
      "source": "/openserv",
      "destination": "/api/openserv"
    },
    {
      "source": "/openserv/:path*",
      "destination": "/api/openserv?path=:path*"
    },
    {
      "source": "/api/openserv/:path+",
      "destination": "/api/openserv?path=:path+"
    }
  ]
}
