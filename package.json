{
  "name": "cheap-first",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Answer with Dolphin's cheap model first, check the answer with SERV Reasoning, and only pay for a frontier model when the check fails.",
  "type": "module",
  "scripts": {
    "ask": "NODE_USE_ENV_PROXY=1 tsx scripts/ask.ts",
    "benchmark": "NODE_USE_ENV_PROXY=1 tsx scripts/benchmark.ts",
    "public-benchmark": "NODE_USE_ENV_PROXY=1 tsx scripts/public-benchmark.ts",
    "public-tune": "NODE_USE_ENV_PROXY=1 tsx scripts/public-tune.ts",
    "public-compare": "NODE_USE_ENV_PROXY=1 tsx scripts/public-compare.ts",
    "build": "tsx scripts/build-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/limits.test.ts src/keys.test.ts src/mcp.test.ts src/mcpStdio.test.ts src/publicGrade.test.ts src/publicReport.test.ts src/liveStats.test.ts src/checkSignals.test.ts src/cheapFirst.test.ts src/speed.test.ts src/visits.test.ts src/pilot.test.ts",
    "mcp": "tsx src/mcpStdio.ts",
    "latency": "NODE_USE_ENV_PROXY=1 tsx scripts/latency.ts",
    "compare-checkers": "NODE_USE_ENV_PROXY=1 tsx scripts/compare-checkers.ts",
    "reppo-sample": "NODE_USE_ENV_PROXY=1 tsx scripts/reppo-sample.ts",
    "hard-benchmark": "NODE_USE_ENV_PROXY=1 tsx scripts/hard-benchmark.ts",
    "verify-test": "NODE_USE_ENV_PROXY=1 tsx scripts/verify-test.ts",
    "near-test": "tsx scripts/near-test.ts",
    "pilot": "NODE_USE_ENV_PROXY=1 tsx scripts/pilot.ts",
    "trial-key": "NODE_USE_ENV_PROXY=1 tsx scripts/trial-key.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.3"
  }
}
