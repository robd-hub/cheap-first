# Firebase web config (public by design: it ships in the page). Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check with reCAPTCHA Enterprise (site key is public).
VITE_RECAPTCHA_SITE_KEY=
# Local development only. Register the token in App Check > Manage debug tokens. Never commit it.
VITE_APPCHECK_DEBUG_TOKEN=
